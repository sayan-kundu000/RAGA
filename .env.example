# RAGA Environment Configuration
# Copy this file to .env and populate your actual API keys

# LLM & Embedding Providers
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Vector Database (Qdrant)
# Use :memory: for lightweight local in-memory execution, or an HTTP URL for local/cloud clusters
QDRANT_URL=:memory:
QDRANT_API_KEY=

# Retrieval & Compression Pipeline Parameters
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=50
HYBRID_RETRIEVAL_CANDIDATES=20
RERANK_MODEL=rerank-english-v3.0
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.3
RRF_K=60

# FastAPI Server
HOST=0.0.0.0
PORT=8000
DEBUG=False
